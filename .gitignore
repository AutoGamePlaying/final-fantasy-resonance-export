# Local dependencies, SDK, caches, game files, and exports
.deps/

# .NET build and test artifacts. Scoped to the .NET trees on purpose: a bare `bin/` also matched
# the Rust binary source `crates/ffr-db/src/bin/`, which then never got committed and broke CI.
/src/**/bin/
/src/**/obj/
/tests/**/bin/
/tests/**/obj/
TestResults/
*.user
*.suo
*.cache
.vs/

# Rust build artifacts
target/

# Distribution packages
dist/

# Unreal mappings / game dumps (never commit)
*.usmap
*.jmap
*.pak
*.ucas
*.utoc
*.uasset
*.umap
*.ubulk
*.locres
!tests/fixtures/rust/db/**/*.jmap

# OS / editor noise
.DS_Store
Thumbs.db
*~
