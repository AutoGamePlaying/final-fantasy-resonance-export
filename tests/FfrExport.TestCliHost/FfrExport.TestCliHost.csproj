<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FfrExport.TestCliHost</AssemblyName>
    <RootNamespace>FfrExport.TestCliHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FfrExport\FfrExport.csproj" />
    <Compile Include="..\FfrExport.Tests\SyntheticFixtureBuilder.cs" Link="SyntheticFixtureBuilder.cs" />
  </ItemGroup>
</Project>
