<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FfrExport\FfrExport.csproj" />
    <ProjectReference Include="..\FfrExport.FakeFfrDb\FfrExport.FakeFfrDb.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FfrExport.TestCliHost\FfrExport.TestCliHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile GUI non-WinForms core logic directly into net10.0 tests for cross-platform xUnit coverage. -->
    <Compile Include="..\..\src\FfrExport.Gui\Core\*.cs" Link="GuiCore\%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CopyTestHelperArtifacts" AfterTargets="Build">
    <ItemGroup>
      <_FakeFfrDbFiles Include="..\FfrExport.FakeFfrDb\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <_TestCliHostFiles Include="..\FfrExport.TestCliHost\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FakeFfrDbFiles)"
          DestinationFiles="@(_FakeFfrDbFiles->'$(OutputPath)fake-ffr-db\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TestCliHostFiles)"
          DestinationFiles="@(_TestCliHostFiles->'$(OutputPath)cli-host\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
