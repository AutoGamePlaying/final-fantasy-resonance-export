<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FfrExport</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(Version)' == '' and Exists('$(MSBuildProjectDirectory)/../../VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../VERSION').Trim())</Version>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" />
    <InternalsVisibleTo Include="FfrExport.Tests" />
    <EmbeddedResource Include="../../known-builds.json" LogicalName="FfrExport.known-builds.json" />
    <EmbeddedResource Include="Resources/FfrUsmapDump/main.lua" LogicalName="FfrExport.FfrUsmapDump.main.lua" />
  </ItemGroup>
  <Target Name="EmbedGitCommitMetadata" BeforeTargets="GetAssemblyAttributes">
    <Exec Condition="'$(FfrGitCommit)' == ''"
          Command="git rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardErrorImportance="Low"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="FfrGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="FfrGitExitCode" />
    </Exec>
    <PropertyGroup>
      <FfrGitCommit Condition="'$(FfrGitExitCode)' != '' and '$(FfrGitExitCode)' != '0'">unknown</FfrGitCommit>
      <FfrGitCommit Condition="'$(FfrGitCommit)' == ''">unknown</FfrGitCommit>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(FfrGitCommit)" />
    </ItemGroup>
  </Target>
</Project>
